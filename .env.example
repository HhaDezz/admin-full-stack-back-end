# Copy to .env and fill in. Used by docker-compose.yml (and by your shell if you export them).

# REQUIRED: at least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=

# The first super admin, created on first start only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

DB_PASSWORD=atelier

# Where browsers reach the API and the web app.
PUBLIC_API_URL=http://localhost:8089
CORS_ALLOWED_ORIGINS=http://localhost:8081

APP_NAME=Anjana
# The web app's public address; links in emails point here.
WEB_URL=http://localhost:8081

# Self sign-up. Set REGISTRATION_ENABLED=false to allow only invited users.
REGISTRATION_ENABLED=true
REGISTRATION_REQUIRE_VERIFICATION=true

# SMTP for real email. Leave MAIL_HOST empty and emails (with their links) go to the API log.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
# true adds four sample users (password Password123!). Leave false in production.
DEMO_USERS=false
